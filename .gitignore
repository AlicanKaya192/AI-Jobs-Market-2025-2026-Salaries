# pyenv
#   For a library or package, you might want to ignore these files since the python version is individual.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if you choose to not write it:
#   Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock can be either ignored or included.
# poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock can be either ignored or included.
# pdm.lock

